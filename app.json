{
  "expo": {
    "name": "Fund-It",
    "slug": "RobinHood",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Fund-It-app-icon.png",
    "scheme": "fundit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sawyerkd.appFundIt",
      "appleTeamId": "TMA6X93UYH",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#8C673A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sawyerkd.appFundIt"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Fund-It-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Fund-It-logo.png",
          "imageWidth": 500,
          "resizeMode": "contain",
          "backgroundColor": "#8C673A",
          "dark": {
            "backgroundColor": "#8C673A"
          }
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      "expo-font",
      "expo-image",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fund-It needs access to your photos to upload PayPal donation screenshots."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "fund-it"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "611c449d-8076-407e-959c-ca2c32dea7ed"
      }
    },
    "owner": "sawyerkd",
    "updates": {
      "url": "https://u.expo.dev/611c449d-8076-407e-959c-ca2c32dea7ed"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
